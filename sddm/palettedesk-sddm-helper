#!/usr/bin/python3 -I
"""Privileged half of `palettedesk sddm sync` (run through pkexec as root). Deliberately tiny and dumb.

It accepts NO arguments and NO file paths. It reads one fixed-format message on stdin:

    PDSDDM1\n
    <surface> <onSurface> <primary> <onPrimary> <container>\n      five colours, each exactly #rrggbb
    <n>\n                                                           0 <= n <= 2000000
    <n bytes>                                                       a JPEG (n = 0: no wallpaper)

and writes exactly two files, theme.conf.user and background.jpg, into the PaletteDesk SDDM theme directory,
refusing symlinks. The image is never decoded here: the caller pre-processes it, and this only checks the JPEG magic.
"""
import os
import re
import stat
import sys

THEME = "/usr/share/sddm/themes/palettedesk"
MAX = 2_000_000
HEX = re.compile(rb"^#[0-9a-fA-F]{6}$")


def fail(msg):
    sys.stderr.write("palettedesk-sddm-helper: " + msg + "\n")
    sys.exit(1)


def write_atomic(dirfd, name, data):
    tmp = ".pd-" + name + ".tmp"
    try:
        os.unlink(tmp, dir_fd=dirfd)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dirfd)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        os.unlink(tmp, dir_fd=dirfd)
        raise
    os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)


def main():
    if len(sys.argv) != 1:
        fail("takes no arguments")
    if os.geteuid() != 0:
        fail("must run as root (via pkexec)")
    inp = sys.stdin.buffer
    if inp.readline() != b"PDSDDM1\n":
        fail("bad header")
    colors = inp.readline().rstrip(b"\n").split(b" ")
    if len(colors) != 5 or not all(HEX.match(c) for c in colors):
        fail("bad colours")
    try:
        n = int(inp.readline().strip())
    except ValueError:
        fail("bad length")
    if not 0 <= n <= MAX:
        fail("image too large")
    img = inp.read(n + 1)
    if len(img) != n:
        fail("image length does not match")
    if n and img[:3] != b"\xff\xd8\xff":
        fail("not a JPEG")

    st = os.lstat(THEME)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        fail("theme directory is missing or not a root-owned directory")
    dirfd = os.open(THEME, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        keys = (b"surface", b"onSurface", b"primary", b"onPrimary", b"container")
        conf = b"[General]\n" + b"".join(k + b"=" + c + b"\n" for k, c in zip(keys, colors))
        if n:
            write_atomic(dirfd, "background.jpg", img)
            conf += b"background=background.jpg\n"
        else:
            try:
                os.unlink("background.jpg", dir_fd=dirfd)
            except FileNotFoundError:
                pass
        write_atomic(dirfd, "theme.conf.user", conf)
    finally:
        os.close(dirfd)


main()
