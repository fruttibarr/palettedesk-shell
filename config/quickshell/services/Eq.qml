pragma Singleton
import Quickshell
import Quickshell.Io
import Quickshell.Services.Pipewire
import QtQuick

// 32-band equalizer backed by the PipeWire filter-chain in
// ~/.config/pipewire/pipewire.conf.d/eq32.conf (generated by scripts/gen-eq.py).
// Chain: preamp -> high-pass -> low-pass -> 32 bands -> limiter.
// State persists in ~/.local/state/rice/eq.json and is re-applied on startup.
Singleton {
    id: root

    readonly property int bands: 32
    readonly property real maxDb: 12
    readonly property var freqs: Array.from({ length: bands }, (_, i) => 20 * Math.pow(1000, i / (bands - 1)))

    readonly property var gains: state.gains.length === bands ? state.gains : Array(bands).fill(0)
    readonly property real bandQ: 4.32     // must match gen-eq.py
    readonly property real filterQ: 0.707

    // Headroom: with "auto" the preamp follows the peak of the real combined
    // response (neighbouring bands add up, so it is more than the tallest band).
    readonly property bool autoHeadroom: state.autoHeadroom
    readonly property real peakDb: Math.max(0, ...curve)
    readonly property real autoPreamp: -Math.ceil(peakDb * 10 - 0.001) / 10
    readonly property real preamp: autoHeadroom ? autoPreamp : state.preamp
    readonly property bool clipping: preamp + peakDb > 0.05   // boosts exceed the headroom

    // High-pass / low-pass (12 dB/octave)
    readonly property bool hpOn: state.hpOn
    readonly property real hpFreq: state.hpFreq
    readonly property bool lpOn: state.lpOn
    readonly property real lpFreq: state.lpFreq
    readonly property real hpMin: 20
    readonly property real hpMax: 1000
    readonly property real lpMin: 1000
    readonly property real lpMax: 20000

    // Volume limiter: output never goes above this ceiling (dBFS). 0 = only catch clipping.
    readonly property real limitDb: state.limitDb
    readonly property real limitMin: -20
    // true = lookahead limiter (swh-plugins), false = hard clip fallback
    property bool realLimiter: false

    // Combined response in dB (bands + filters, without preamp) at curveFreqs
    readonly property int curvePoints: 311
    readonly property var curveFreqs: Array.from({ length: curvePoints }, (_, i) => 20 * Math.pow(1000, i / (curvePoints - 1)))
    readonly property var curve: curveFreqs.map(f => responseDb(f))
    readonly property bool enabled: state.enabled
    readonly property string preset: state.preset

    readonly property PwNode node: Pipewire.nodes.values.find(n => n.name === "eq32_input") ?? null
    readonly property int nodeId: node?.id ?? -1
    readonly property bool available: nodeId >= 0

    readonly property var presetNames: ["Flat", "Bass boost", "Treble boost", "Vocal", "Loudness"]

    function label(f) {
        return f < 1000 ? Math.round(f).toString() : (f / 1000).toFixed(f < 10000 ? 1 : 0).replace(".0", "") + "k";
    }

    // Magnitude of the whole chain at f (analog prototypes of the biquads)
    function responseDb(f) {
        let p = 1;   // power ratio
        for (let i = 0; i < bands; i++) {
            const g = gains[i];
            if (g === 0) continue;
            const a = Math.pow(10, g / 40), x = f / freqs[i], d = (1 - x * x) * (1 - x * x);
            p *= (d + Math.pow(a * x / bandQ, 2)) / (d + Math.pow(x / (a * bandQ), 2));
        }
        if (hpOn) {
            const x = f / hpFreq;
            p *= Math.pow(x, 4) / (Math.pow(1 - x * x, 2) + Math.pow(x / filterQ, 2));
        }
        if (lpOn) {
            const x = f / lpFreq;
            p *= 1 / (Math.pow(1 - x * x, 2) + Math.pow(x / filterQ, 2));
        }
        return 10 * Math.log10(Math.max(p, 1e-12));
    }

    function presetGain(name, f) {
        const oct = x => Math.log2(x);
        const clamp = x => Math.max(0, Math.min(1, x));
        const bell = (center, width) => Math.exp(-Math.pow(oct(f / center), 2) / (2 * width * width));
        switch (name) {
        case "Bass boost":   return 7 * clamp(1 - oct(f / 60) / oct(250 / 60));
        case "Treble boost": return 6 * clamp(oct(f / 2000) / oct(12000 / 2000));
        case "Vocal":        return 4 * bell(2200, 1.0) - 2.5 * clamp(1 - oct(f / 50) / oct(160 / 50));
        case "Loudness":     return 5 * bell(50, 1.2) + 4 * bell(10000, 1.2) - 1 * bell(1000, 1.0);
        default:             return 0;
        }
    }

    function applyPreset(name) {
        const g = freqs.map(f => Math.round(presetGain(name, f) * 2) / 2);
        state.gains = g;
        state.preset = name;
        if (!autoHeadroom) state.preamp = Math.max(-18, autoPreamp);   // headroom so boosts don't clip
        changed();
    }

    function setGain(i, db) {
        const g = gains.slice();
        g[i] = Math.round(Math.max(-maxDb, Math.min(maxDb, db)) * 2) / 2;
        state.gains = g;
        state.preset = "Custom";
        changed();
    }

    readonly property real preampMin: -18
    readonly property real preampMax: 6

    // Setting the preamp by hand turns auto headroom off
    function setPreamp(db) {
        state.autoHeadroom = false;
        state.preamp = Math.round(Math.max(preampMin, Math.min(preampMax, db)) * 2) / 2;
        changed();
    }

    function setAutoHeadroom(on) {
        if (!on) state.preamp = Math.round(Math.max(preampMin, autoPreamp) * 2) / 2;
        state.autoHeadroom = on;
        changed();
    }

    function niceFreq(f) {
        const step = f < 100 ? 1 : f < 1000 ? 10 : f < 10000 ? 100 : 500;
        return Math.round(f / step) * step;
    }

    function setHighPass(on, freq) {
        state.hpOn = on;
        if (freq > 0) state.hpFreq = niceFreq(Math.max(hpMin, Math.min(hpMax, freq)));
        changed();
    }

    function setLowPass(on, freq) {
        state.lpOn = on;
        if (freq > 0) state.lpFreq = niceFreq(Math.max(lpMin, Math.min(lpMax, freq)));
        changed();
    }

    function setLimit(db) {
        state.limitDb = Math.round(Math.max(limitMin, Math.min(0, db)) * 2) / 2;
        changed();
    }

    function setEnabled(on) {
        state.enabled = on;
        changed();
    }

    function changed() { applyTimer.restart(); saveTimer.restart(); }

    function apply() {
        if (!available) return;
        // Off with a volume limit set: stay in the path but flat, so the limit still holds
        const on = enabled;
        const mult = on ? Math.pow(10, preamp / 20) : 1;
        const hp = on && hpOn ? hpFreq : 0;            // 0 Hz = pass-through
        const lp = on && lpOn ? lpFreq : 1000000;      // above Nyquist = pass-through
        const params = [];
        for (const ch of ["L", "R"]) {
            params.push(`"preamp${ch}:Mult" ${mult.toFixed(4)}`);
            params.push(`"hp${ch}:Freq" ${hp.toFixed(1)}`);
            params.push(`"lp${ch}:Freq" ${lp.toFixed(1)}`);
            gains.forEach((g, i) => params.push(`"b${i + 1}${ch}:Gain" ${(on ? g : 0).toFixed(1)}`));
            if (!realLimiter) {
                const c = Math.pow(10, limitDb / 20).toFixed(4);
                params.push(`"lim${ch}:Min" -${c}`, `"lim${ch}:Max" ${c}`);
            }
        }
        if (realLimiter) params.push(`"lim:Limit (dB)" ${limitDb.toFixed(1)}`);
        Quickshell.execDetached(["pw-cli", "set-param", String(nodeId), "Props", `{ params = [ ${params.join(" ")} ] }`]);
        // Off (and no volume limit) = true bypass: tell WirePlumber to route around the filter
        const bypass = !enabled && limitDb >= 0;
        Quickshell.execDetached(["pw-metadata", "-n", "filters", String(nodeId), "filter.smart.disabled", bypass ? "true" : "false"]);
    }

    onNodeIdChanged: if (available) applyTimer.restart()

    Timer { id: applyTimer; interval: 30; onTriggered: root.apply() }
    Timer { id: saveTimer; interval: 500; onTriggered: file.writeAdapter() }

    // Which limiter the loaded filter graph has
    FileView {
        path: Quickshell.env("HOME") + "/.config/pipewire/pipewire.conf.d/eq32.conf"
        watchChanges: true
        onFileChanged: reload()
        onLoaded: { root.realLimiter = text().includes("type = ladspa"); applyTimer.restart(); }
    }

    FileView {
        id: file
        path: Quickshell.env("HOME") + "/.local/state/rice/eq.json"
        onLoaded: applyTimer.restart()
        onLoadFailed: writeAdapter()

        JsonAdapter {
            id: state
            property var gains: []
            property real preamp: 0
            property bool enabled: true
            property string preset: "Flat"
            property bool autoHeadroom: true
            property bool hpOn: false
            property real hpFreq: 30
            property bool lpOn: false
            property real lpFreq: 16000
            property real limitDb: 0
        }
    }
}
